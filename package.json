{
  "name": "use-video-recording",
  "version": "1.0.3",
  "description": "A powerful and easy-to-use React hook for video recording functionality with MediaRecorder API support",
  "license": "MIT",
  "author": {
    "name": "Dmitrii Selikhov",
    "email": "dmitrii.selikhov@gmail.com",
    "url": "https://www.linkedin.com/in/dimetrix"
  },
  "contributors": [
    {
      "name": "Dmitrii Selikhov",
      "email": "dmitrii.selikhov@gmail.com",
      "url": "https://www.linkedin.com/in/dimetrix"
    }
  ],
  "email": "dmitrii.selikhov@gmail.com",
  "scripts": {
    "build": "tsup ./src",
    "watch": "tsup ./src --watch",
    "run": "node dist/index.js",
    "dev": "pnpm run watch & nodemon dist/index.js",
    "prettier": "prettier --write src/**",
    "format": "pnpm run prettier && pnpm type",
    "bootstrap": "pnpm install && pnpm format",
    "type": "tsc --noEmit --incremental",
    "tsc:clean": "tsc --build --clean",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "homepage": "https://github.com/idimetrix/use-video-recording#readme",
  "url": "https://github.com/idimetrix/use-video-recording/issue",
  "bugs": {
    "url": "https://github.com/idimetrix/use-video-recording/issues"
  },
  "keywords": [
    "react",
    "hook",
    "video",
    "recording",
    "mediarecorder",
    "camera",
    "typescript",
    "webcam",
    "media",
    "streaming"
  ],
  "files": [
    "dist",
    "package.json"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "react": "19.1.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "husky": "9.1.7",
    "jest": "30.1.3",
    "lint-staged": "16.2.0",
    "nodemon": "3.1.10",
    "prettier": "3.6.2",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "tsup": "8.5.0",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write"
    ]
  }
}
