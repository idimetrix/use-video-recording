{
  "name": "use-video-recording",
  "version": "1.1.0",
  "description": "A professional, feature-rich React hook for video recording with MediaRecorder API. Supports pause/resume, error handling, duration tracking, and download functionality.",
  "license": "MIT",
  "author": {
    "name": "Dmitrii Selikhov",
    "email": "dmitrii.selikhov@gmail.com",
    "url": "https://www.linkedin.com/in/dimetrix"
  },
  "contributors": [
    {
      "name": "Dmitrii Selikhov",
      "email": "dmitrii.selikhov@gmail.com",
      "url": "https://www.linkedin.com/in/dimetrix"
    }
  ],
  "email": "dmitrii.selikhov@gmail.com",
  "scripts": {
    "build": "npm run clean && tsup",
    "clean": "rimraf dist",
    "watch": "tsup ./src --watch",
    "dev": "npm run watch",
    "prettier": "prettier --write 'src/**/*.{ts,tsx}'",
    "lint": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "npm run prettier && npm run type",
    "type": "tsc --noEmit --incremental",
    "typecheck": "tsc --noEmit",
    "prepare": "husky && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --watchAll=false",
    "validate": "npm run typecheck && npm run test:ci && npm run build",
    "prepublishOnly": "npm run validate"
  },
  "homepage": "https://github.com/idimetrix/use-video-recording#readme",
  "url": "https://github.com/idimetrix/use-video-recording/issue",
  "bugs": {
    "url": "https://github.com/idimetrix/use-video-recording/issues"
  },
  "keywords": [
    "react",
    "hook",
    "video",
    "recording",
    "mediarecorder",
    "camera",
    "typescript",
    "webcam",
    "media",
    "streaming",
    "screen-recording",
    "audio-recording",
    "webrtc",
    "multimedia"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/eslint__js": "8.42.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "eslint": "9.36.0",
    "husky": "9.1.7",
    "jest": "30.1.3",
    "jest-environment-jsdom": "30.1.2",
    "lint-staged": "16.2.0",
    "nodemon": "3.1.10",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/idimetrix/use-video-recording.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  }
}
